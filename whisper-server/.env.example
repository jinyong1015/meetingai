# MeetingAI local Whisper (faster-whisper)
#
# Prerequisites
# 1) Python 3.10+
# 2) ffmpeg on PATH  →  winget install Gyan.FFmpeg  (then reopen terminal)
#
# Setup (once)
#   cd whisper-server
#   python -m venv .venv
#   .\.venv\Scripts\Activate.ps1
#   pip install -r requirements.txt
#
# Run
#   .\.venv\Scripts\Activate.ps1
#   python app.py
#
# Or:
#   .\start.ps1
#
# Health check: http://127.0.0.1:8080/health
#
# Next.js (.env.local)
#   STT_PROVIDER=whisper
#   WHISPER_API_URL=http://127.0.0.1:8080/v1/audio/transcriptions
#   WHISPER_MODEL=small
#
# Optional env for this server:
#   WHISPER_MODEL=small|base|tiny|medium|large-v3
#   WHISPER_DEVICE=cpu|cuda
#   WHISPER_COMPUTE_TYPE=int8|float16|int8_float16
#   WHISPER_HOST=127.0.0.1
#   WHISPER_PORT=8080

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8080
