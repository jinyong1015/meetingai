# Copy to `.env.local` and fill in real values.
# Never commit `.env.local`.

# Default STT: whisper (local) | assemblyai (cloud)
STT_PROVIDER=whisper

# Local faster-whisper server (OpenAI-compatible)
WHISPER_API_URL=http://127.0.0.1:8080/v1/audio/transcriptions
WHISPER_MODEL=small
# WHISPER_API_KEY=   # local server does not need a key

# Optional cloud STT (only if you use AssemblyAI)
# ASSEMBLYAI_API_KEY=

# LLM (summary + detailed minutes)
# openai | ollama  — 설정 UI에서도 선택 가능 (IndexedDB)
LLM_PROVIDER=ollama

# OpenAI (cloud LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Ollama (local LLM) — default http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# ollama list 로 확인한 이름 (예: gemma4:26b)
OLLAMA_MODEL=gemma4:26b

# Make.com webhook (확정본 메모·요약·회의록 마크다운 전송)
# MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-path
