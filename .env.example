# Copy to `.env.local` and fill in real values.
# Never commit `.env.local`.

# Default STT: whisper (local, browser→user PC) | assemblyai (cloud via Vercel)
STT_PROVIDER=whisper

# Local Whisper defaults (browser uses these as seeds; not secrets)
# Actual calls go from the browser to the user's PC, not from Vercel → localhost.
WHISPER_API_URL=http://127.0.0.1:8080/v1/audio/transcriptions
WHISPER_MODEL=small
# WHISPER_API_KEY=   # local server does not need a key
# WHISPER_CORS_ORIGINS=*  # set on whisper-server process for Vercel HTTPS origins

# Optional cloud STT (server-side only — never expose to the browser)
# ASSEMBLYAI_API_KEY=

# LLM: openai (cloud via Vercel) | ollama (local, browser→user PC)
LLM_PROVIDER=ollama

# OpenAI (cloud LLM — server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Local Ollama defaults (browser seeds; not secrets)
OLLAMA_BASE_URL=http://localhost:11434
# ollama list 로 확인한 이름 (예: gemma4:26b, qwen3:8b)
OLLAMA_MODEL=gemma4:26b
# On the machine running Ollama, allow your app Origin, e.g.:
#   $env:OLLAMA_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,*"
#   ollama serve

# Make.com webhook (확정본 메모·요약·회의록 마크다운 전송)
# MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-path
